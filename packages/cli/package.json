{
  "name": "oh-my-otter",
  "version": "0.0.0",
  "description": "Local repository readiness scanner for AI coding agents",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wemilabs/oh-my-otter.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "omot": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@oh-my-otter/checks": "workspace:*",
    "@oh-my-otter/core": "workspace:*",
    "commander": "^15.0.0",
    "execa": "^10.1.0",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.6"
  }
}
