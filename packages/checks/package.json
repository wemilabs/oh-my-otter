{
  "name": "@oh-my-otter/checks",
  "version": "0.5.2",
  "description": "Built-in repository readiness checks for Oh My Otter",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wemilabs/oh-my-otter.git",
    "directory": "packages/checks"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-package-files.mjs LICENSE",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@oh-my-otter/core": "workspace:*",
    "ignore": "^7.0.12"
  }
}
